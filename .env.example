# ==============================================================================
# Automated Environment Configuration Template (.env.example)
# Generated by config.SchemaEngine
# ==============================================================================

# HTTP server binding host interface
# Default: 0.0.0.0
HOST=0.0.0.0

# HTTP server TCP listen port
# Default: 8080
PORT=8080

# Maximum duration for reading request headers and body
# Default: 5s
READ_TIMEOUT=5s

# Maximum duration for reading request headers (slowloris protection)
# Default: 2s
READ_HEADER_TIMEOUT=2s

# Maximum duration for writing HTTP response
# Default: 10s
WRITE_TIMEOUT=10s

# Idle keep-alive duration before closing a connection
# Default: 120s
IDLE_TIMEOUT=120s

# Maximum duration allowed for graceful server shutdown
# Default: 15s
SHUTDOWN_TIMEOUT=15s

# Initial pause to allow load balancer health check failure propagation
# Default: 5s
DRAIN_DURATION=5s

# Maximum permitted HTTP request header bytes
# Default: 1MB
MAX_HEADER_BYTES=1MB

# Maximum permitted HTTP request body size
# Default: 10MB
MAX_BODY_SIZE=10MB

# Minimum log level (debug, info, warn, error)
# Default: info
LOG_LEVEL=info

# Force colored terminal output even when not attached to a TTY
# Default: false
LOG_COLOR=false

# Enable file-based JSON log persistence
# Default: true
LOG_TO_FILE=true

# Directory for log file output (app.log, error.log)
# Default: logs
LOG_DIR=logs

# Database driver (supported: 'postgres', 'memory')
# Default: postgres
DB_DRIVER=postgres

# Database server host or IP
# Default: localhost
DB_HOST=localhost

# Database server TCP port
# Default: 5432
DB_PORT=5432

# Target database name
# Default: train_db
DB_NAME=train_db

# Database authentication user
# Default: train_user
DB_USER=train_user

# Database authentication password
DB_PASSWORD=

# Direct database connection URI override
DATABASE_URL=

# Maximum open connections pool size
# Default: 25
DB_MAX_OPEN_CONNS=25

# Maximum idle connections pool size
# Default: 25
DB_MAX_IDLE_CONNS=25

# Cryptographic secret key for signing JWT tokens
# Default: default-development-jwt-secret-key-32-chars-min
JWT_SECRET=default-development-jwt-secret-key-32-chars-min

# Time-to-live duration for JWT authentication tokens
# Default: 24h
JWT_TOKEN_TTL=24h
